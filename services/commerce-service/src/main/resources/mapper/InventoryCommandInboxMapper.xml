<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="vip.fairy.commerceflow.commerce.inventory.infrastructure.InventoryCommandInboxMapper">

  <insert id="claim">
    INSERT IGNORE INTO inventory_command_inbox(
      command_id,command_type,order_id,payload_fingerprint,status
    ) VALUES(
      #{commandId},#{commandType},#{orderId},#{payloadFingerprint},'PROCESSING'
    )
  </insert>

  <select id="payloadFingerprint" resultType="java.lang.String">
    SELECT payload_fingerprint
    FROM inventory_command_inbox
    WHERE command_id=#{commandId}
  </select>

  <update id="complete">
    UPDATE inventory_command_inbox
    SET status='SUCCEEDED',processed_at=CURRENT_TIMESTAMP(6)
    WHERE command_id=#{commandId} AND status='PROCESSING'
  </update>

</mapper>
