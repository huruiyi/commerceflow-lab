<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="vip.fairy.commerceflow.commerce.catalog.infrastructure.CatalogEventOutboxMapper">

  <insert id="insert">
    INSERT INTO catalog_event_outbox(
      event_id,event_type,aggregate_id,schema_version,business_version,occurred_at,
      correlation_id,causation_id,payload
    ) VALUES (
      #{event.eventId},#{event.eventType},#{event.productId},#{event.schemaVersion},
      #{event.businessVersion},#{event.occurredAt},#{event.correlationId},#{event.causationId},#{payload}
    )
  </insert>
</mapper>
