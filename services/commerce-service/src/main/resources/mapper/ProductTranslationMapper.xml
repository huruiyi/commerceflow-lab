<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="vip.fairy.commerceflow.commerce.catalog.infrastructure.ProductTranslationMapper">

  <select id="find" resultType="vip.fairy.commerceflow.commerce.catalog.domain.ProductTranslation">
    <![CDATA[
      SELECT * FROM product_translations WHERE product_id=#{productId} AND locale=#{locale}
    ]]>
  </select>
</mapper>
