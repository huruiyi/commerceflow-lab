<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="vip.fairy.commerceflow.commerce.payment.infrastructure.PaymentProcessMapper">

  <select id="findByCommandId" resultType="vip.fairy.commerceflow.commerce.payment.domain.PaymentProcessView">
    SELECT * FROM payment_process_managers WHERE command_id=#{commandId}
  </select>
  <select id="findByCorrelation" resultType="vip.fairy.commerceflow.commerce.payment.domain.PaymentProcessView">
    SELECT * FROM payment_process_managers WHERE order_id=#{orderId} AND correlation_id=#{correlationId}
  </select>
  <select id="findByProcessId" resultType="vip.fairy.commerceflow.commerce.payment.domain.PaymentProcessView">
    SELECT * FROM payment_process_managers WHERE process_id=#{processId}
  </select>
  <select id="resultFingerprint" resultType="java.lang.String">
    SELECT payload_fingerprint FROM payment_result_inbox WHERE result_id=#{resultId}
  </select>
  <insert id="insertProcess">
    INSERT INTO payment_process_managers(process_id,order_id,process_type,status,command_id,
      command_fingerprint,correlation_id,causation_id,traceparent,result_deadline_at,next_check_at)
    VALUES(#{processId},#{orderId},'PAYMENT_CREATE','WAITING_RESULT',#{commandId},#{fingerprint},
      #{correlationId},#{causationId},#{traceparent},#{deadline},#{deadline})
  </insert>
  <insert id="insertCommand">
    INSERT INTO payment_command_outbox(command_id,process_id,order_id,command_type,payload_fingerprint,
      payload,result_deadline_at,correlation_id,causation_id,traceparent)
    VALUES(#{commandId},#{processId},#{orderId},'PAYMENT_CREATE',#{fingerprint},#{payload},#{deadline},
      #{correlationId},#{causationId},#{traceparent})
  </insert>
  <insert id="insertResult">
    INSERT INTO payment_result_inbox(result_id,process_id,order_id,result_type,outcome,payload_fingerprint,
      payload,processing_status,error_detail,correlation_id,causation_id,traceparent,processed_at)
    VALUES(#{resultId},#{processId},#{orderId},#{resultType},#{outcome},#{fingerprint},#{payload},
      #{processingStatus},#{errorDetail},#{correlationId},#{causationId},#{traceparent},CURRENT_TIMESTAMP)
  </insert>
  <update id="applyResult">
    UPDATE payment_process_managers SET status=#{status},last_error=#{error},version=version+1,
      completed_at=CASE WHEN #{status}='COMPLETED' THEN CURRENT_TIMESTAMP ELSE NULL END,
      updated_at=CURRENT_TIMESTAMP WHERE process_id=#{processId} AND status='WAITING_RESULT'
  </update>
  <update id="markExpired">
    UPDATE payment_process_managers SET status='RECONCILIATION_REQUIRED',
      last_error='RESULT_TIMEOUT',version=version+1,updated_at=CURRENT_TIMESTAMP
    WHERE status='WAITING_RESULT' AND result_deadline_at &lt;= #{now}
  </update>
  <update id="retry">
    UPDATE payment_process_managers SET status='WAITING_RESULT',recovered_by=#{operator},
      recovery_reason=#{reason},recovered_at=CURRENT_TIMESTAMP,result_deadline_at=#{deadline},
      next_check_at=#{deadline},last_error=NULL,version=version+1,updated_at=CURRENT_TIMESTAMP
    WHERE process_id=#{processId} AND status='RECONCILIATION_REQUIRED'
  </update>
  <update id="requeueCommand">
    UPDATE payment_command_outbox SET status='RETRY',next_attempt_at=CURRENT_TIMESTAMP,
      result_deadline_at=#{deadline},last_error=NULL WHERE process_id=#{processId}
  </update>
</mapper>
