# All values are local teaching defaults. Never reuse them in production.
COMPOSE_PROJECT_NAME=fairy-commerceflow
COMPOSE_PATH_SEPARATOR=|
COMPOSE_FILE=compose.yaml|infrastructure/compose/compose.fulfillment-execution.yaml|infrastructure/compose/compose.reference-data.yaml|infrastructure/compose/compose.daily-postgresql.yaml|infrastructure/compose/compose.catalog-elasticsearch.yaml

# For existing daily PostgreSQL volumes, supply the current values in a private environment file.
# CATALOG_PG_ADMIN_PASSWORD=
# CATALOG_PG_RUNTIME_PASSWORD=
# COMMERCE_POSTGRES_ADMIN_PASSWORD=
# COMMERCE_POSTGRES_RUNTIME_PASSWORD=
# FULFILLMENT_PG_ADMIN_PASSWORD=
# FULFILLMENT_PG_RUNTIME_PASSWORD=
# INVENTORY_PG_ADMIN_PASSWORD=
# INVENTORY_PG_RUNTIME_PASSWORD=
# INVOICE_CALLBACK_SECRET=
# INVOICE_PG_ADMIN_PASSWORD=
# INVOICE_PG_RUNTIME_PASSWORD=
# INVOICE_REQUEST_SECRET=
# LOGISTICS_PG_ADMIN_PASSWORD=
# LOGISTICS_PG_RUNTIME_PASSWORD=
# MESSAGING_PG_ADMIN_PASSWORD=
# MESSAGING_PG_RUNTIME_PASSWORD=
# NOTIFICATION_DATABASE_PASSWORD=
# NOTIFICATION_POSTGRESQL_ADMIN_PASSWORD=
# ORDER_PG_ADMIN_PASSWORD=
# ORDER_PG_RUNTIME_PASSWORD=
# PAYMENT_ORCHESTRATION_PG_ADMIN_PASSWORD=
# PAYMENT_ORCHESTRATION_PG_RUNTIME_PASSWORD=
# PAYMENT_SIMULATOR_PG_ADMIN_PASSWORD=
# PAYMENT_SIMULATOR_PG_RUNTIME_PASSWORD=
# REFERENCE_DATA_DB_PASSWORD=
# WAREHOUSE_PG_ADMIN_PASSWORD=
# WAREHOUSE_PG_RUNTIME_PASSWORD=

COMMERCE_RUNTIME_DATABASE_USERNAME=commerce_runtime
COMMERCE_RUNTIME_DATABASE_PASSWORD=commerce-runtime-password
ORDER_DATABASE_USERNAME=orders
ORDER_DATABASE_PASSWORD=orders-password
MESSAGING_DATABASE_USERNAME=messaging
MESSAGING_DATABASE_PASSWORD=messaging-password
MESSAGING_ADMIN_TOKEN=demo-messaging-admin-token
MESSAGING_SENDER_SECRET=demo-messaging-sender-secret
MESSAGING_FAULTS_ENABLED=false
WAREHOUSE_DATABASE_USERNAME=warehouse
WAREHOUSE_DATABASE_PASSWORD=warehouse-password
WAREHOUSE_ADMIN_TOKEN=demo-warehouse-admin-token
WAREHOUSE_RETURN_SECRET=demo-warehouse-return-secret
FULFILLMENT_WAREHOUSE_SECRET=demo-fulfillment-warehouse-secret
# Default transport uses the independent order and payment owners.
ORDER_ACCEPTING_TRAFFIC=true
ORDER_INTERNAL_SECRET=demo-order-internal-secret
PAYMENT_ORDER_INTERNAL_SECRET=demo-payment-order-internal-secret
PAYMENT_ORCHESTRATION_DATABASE_USERNAME=payments
PAYMENT_ORCHESTRATION_DATABASE_PASSWORD=payments-password
PAYMENT_ACCEPTING_TRAFFIC=true
PAYMENT_EFFECTS_ENABLED=true
PAYMENT_EFFECTS_BATCH_SIZE=20
PAYMENT_INTERNAL_SECRET=demo-payment-internal-secret
PAYMENT_INVENTORY_INTERNAL_SECRET=demo-payment-inventory-internal-secret
PAYMENT_DATABASE_USERNAME=payment
PAYMENT_DATABASE_PASSWORD=payment-password
LOGISTICS_DATABASE_USERNAME=logistics
LOGISTICS_DATABASE_PASSWORD=logistics-password
LOGISTICS_APP_ID=commerceflow-storefront
LOGISTICS_ADMIN_TOKEN=demo-logistics-admin-token
LOGISTICS_REQUEST_SECRET=demo-logistics-request-secret
LOGISTICS_CALLBACK_SECRET=demo-logistics-callback-secret
LOGISTICS_CALLBACK_DELIVERY_ENABLED=true
LOGISTICS_CALLBACK_DELIVERY_INITIAL_DELAY=2s
LOGISTICS_CALLBACK_DELIVERY_SCAN_INTERVAL=1s
LOGISTICS_CALLBACK_DELIVERY_RETRY_DELAY=2s
LOGISTICS_CALLBACK_DELIVERY_CLAIM_LEASE=30s
LOGISTICS_CALLBACK_DELIVERY_CONNECT_TIMEOUT=2s
LOGISTICS_CALLBACK_DELIVERY_READ_TIMEOUT=3s
LOGISTICS_CALLBACK_DELIVERY_BATCH_SIZE=50
LOGISTICS_CALLBACK_DELIVERY_MAX_ATTEMPTS=10
RABBITMQ_USERNAME=commerceflow
KAFKA_PRODUCER_MAX_BLOCK_MS=5000
KAFKA_PRODUCER_REQUEST_TIMEOUT_MS=3000
KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS=5000
NOTIFICATION_DELIVERY_TOPIC=customer-notification-commands
NOTIFICATION_DELIVERY_MAX_ATTEMPTS=5
NOTIFICATION_DELIVERY_RETRY_DELAY=5s
NOTIFICATION_PUBLISH_INITIAL_DELAY=2s
NOTIFICATION_PUBLISH_DELAY=1s
NOTIFICATION_DATABASE_USERNAME=notification
NOTIFICATION_DATABASE_PASSWORD=notification-password
NOTIFICATION_POSTGRESQL_ADMIN_PASSWORD=local-notification-postgres-password
NOTIFICATION_POSTGRESQL_FLYWAY_ENABLED=false
NOTIFICATION_POSTGRESQL_OFFSET_RESET=none
