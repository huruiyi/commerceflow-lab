SCHEDULING_RABBITMQ_DELAY_EXCHANGE=commerceflow.scheduled-task.delay
SCHEDULING_RABBITMQ_READY_EXCHANGE=commerceflow.scheduled-task.ready
SCHEDULING_RABBITMQ_DEAD_EXCHANGE=commerceflow.scheduled-task.dead
SCHEDULING_RABBITMQ_READY_QUEUE=commerceflow.scheduled-task.ready
SCHEDULING_RABBITMQ_DEAD_QUEUE=commerceflow.scheduled-task.dead
SCHEDULING_RABBITMQ_READY_ROUTING_KEY=scheduled-task.ready
SCHEDULING_RABBITMQ_DEAD_ROUTING_KEY=scheduled-task.dead
SCHEDULING_RABBITMQ_DELAY_BUCKETS=1s,5s,30s,5m,30m,2h,1d
SCHEDULING_ROCKETMQ_ENABLED=false
SCHEDULING_ROCKETMQ_ENDPOINTS=rocketmq-broker:8081
SCHEDULING_ROCKETMQ_TOPIC=commerceflow-scheduled-task
SCHEDULING_ROCKETMQ_CONSUMER_GROUP=commerceflow-scheduled-task-consumer
ROCKETMQ_CONSUMER_RETRY_MAX_TIMES=2
SCHEDULING_ROCKETMQ_TAG=SCHEDULED_TASK
SCHEDULING_ROCKETMQ_REQUEST_TIMEOUT=5s
SCHEDULING_ROCKETMQ_PUBLISH_INITIAL_DELAY=2s
SCHEDULING_ROCKETMQ_PUBLISH_FIXED_DELAY=1s
SCHEDULING_ROCKETMQ_PUBLISH_BATCH_SIZE=100
