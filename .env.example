LOGISTICS_RECONCILIATION_ENABLED=true
LOGISTICS_RECONCILIATION_INITIAL_DELAY=30s
LOGISTICS_RECONCILIATION_SCAN_INTERVAL=1m
LOGISTICS_RECONCILIATION_STALE_AFTER=5m
LOGISTICS_RECONCILIATION_BATCH_SIZE=100
LOGISTICS_AUTO_PROGRESS_ENABLED=false
LOGISTICS_AUTO_PROGRESS_INITIAL_DELAY=10s
LOGISTICS_AUTO_PROGRESS_SCAN_INTERVAL=5s
LOGISTICS_AUTO_PROGRESS_STEP_INTERVAL=5m
LOGISTICS_AUTO_PROGRESS_BATCH_SIZE=100
ORDER_AUTO_RECEIVE_AFTER_DELIVERY=7d
ORDER_AUTO_COMPLETE_AFTER_RECEIPT=7d
PAYMENT_CALLBACK_SECRET=demo-platform-callback-secret
PAYMENT_CREDENTIAL_MASTER_KEY=bG9jYWwtZGVtby1rZXktMTIzNDU2Nzg5MC1hYmNkZWY=
REMEMBER_ME_KEY=commerceflow-demo-remember-me-key-change-in-production
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=commerceflow-grafana
# OpenTelemetry trace export stays disabled unless the observability profile is started explicitly.
TRACING_EXPORT_ENABLED=false
TRACING_OTLP_ENDPOINT=http://tempo:4318/v1/traces
TRACING_SAMPLING_PROBABILITY=1.0
