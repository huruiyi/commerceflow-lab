<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="vip.fairy.commerceflow.simulator.payment.mapper.PaymentAdminMfaCredentialMapper">

  <delete id="deleteRecoveryCodes">
    <![CDATA[
      DELETE FROM payment_admin_mfa_recovery_code WHERE user_id=#{userId}
    ]]>
  </delete>

  <insert id="insertRecoveryCode">
    <![CDATA[
      INSERT INTO payment_admin_mfa_recovery_code(user_id, code_hash) VALUES(#{userId}, #{hash})
    ]]>
  </insert>

  <select id="selectUnusedRecoveryCodes"
          resultType="vip.fairy.commerceflow.simulator.payment.mapper.PaymentAdminMfaCredentialMapper$RecoveryCodeRow">
    <![CDATA[
      SELECT id, code_hash FROM payment_admin_mfa_recovery_code WHERE user_id=#{userId} AND used_at IS NULL
    ]]>
  </select>

  <update id="consumeRecoveryCode">
    <![CDATA[
      UPDATE payment_admin_mfa_recovery_code SET used_at=CURRENT_TIMESTAMP(6) WHERE id=#{id} AND used_at IS NULL
    ]]>
  </update>
</mapper>
