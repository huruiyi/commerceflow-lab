<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="vip.fairy.commerceflow.simulator.payment.mapper.ChannelTransactionMapper">
  <select id="lockRefundPayment" resultType="vip.fairy.commerceflow.simulator.payment.domain.ChannelTransaction">
    SELECT * FROM channel_transaction
    WHERE merchant_id=#{merchantId} AND channel_transaction_no=#{transactionNo} FOR UPDATE
  </select>
</mapper>
