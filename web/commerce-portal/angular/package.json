{
  "name": "commerce-portal-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss}\" \"libs/**/*.{ts,html,css,scss}\" \"*.{json,js}\" \".postcssrc.json\"",
    "format:write": "prettier --write \"src/**/*.{ts,html,css,scss}\" \"libs/**/*.{ts,html,css,scss}\" \"*.{json,js}\" \".postcssrc.json\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "engines": {
    "node": ">=26.13.0",
    "npm": ">=11.20.0"
  },
  "dependencies": {
    "@angular/animations": "22.2.6",
    "@angular/cdk": "22.2.7",
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/platform-browser-dynamic": "22.2.6",
    "@angular/router": "22.2.6",
    "@ng-icons/core": "36.1.0",
    "@ng-icons/lucide": "36.1.0",
    "@spartan-ng/brain": "1.8.0",
    "bootstrap": "5.3.9",
    "bootstrap-icons": "1.13.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "rxjs": "7.8.2",
    "tailwind-merge": "3.7.0",
    "tslib": "2.8.1",
    "tw-animate-css": "1.4.0",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.6",
    "@angular/localize": "22.2.6",
    "@tailwindcss/postcss": "4.3.5",
    "@types/jasmine": "5.1.15",
    "jasmine-core": "5.13.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "postcss": "8.5.32",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  }
